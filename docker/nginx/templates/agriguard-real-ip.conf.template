# Production only (mounted by docker-compose.prod.yml; the nginx image fills in the variable
# and writes /etc/nginx/conf.d/agriguard-real-ip.conf, which nginx.conf includes).
# Requests reach NGINX only through the HTTPS proxy (Caddy) at AGRIGUARD_CADDY_IP. Take the
# visitor's address from the X-Forwarded-For header Caddy sets, and only from Caddy, so the
# per-address rate limits count each visitor separately and nobody can fake an address.
set_real_ip_from ${AGRIGUARD_CADDY_IP};
real_ip_header X-Forwarded-For;
real_ip_recursive on;
