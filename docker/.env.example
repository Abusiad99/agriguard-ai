# AgriGuard AI — OPTIONAL Docker Compose deployment configuration.
# Docker is not required for development; see README.md for the native setup.
#
# Copy to docker/.env (Compose reads .env from the directory holding
# docker-compose.yml) and set real values. Never commit docker/.env.
# Only the variables docker-compose.yml interpolates are listed here; every other
# backend setting is fixed inside the compose file for the container layout.

# --- Required ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# With APP_ENV=production the backend refuses to start if this is shorter than 32 characters.
JWT_SECRET_KEY=
POSTGRES_PASSWORD=change-me

# --- App ---
APP_ENV=production
DEBUG=false
CORS_ALLOW_ORIGINS=["http://localhost"]
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1/forecast

# --- Gemini (optional; empty = disabled) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- Networking ---
# Compose network subnet, and the fixed nginx address inside it that the backend
# trusts for X-Forwarded-For. Change both together if the subnet collides with an
# existing Docker network on the host.
AGRIGUARD_SUBNET=172.28.0.0/16
AGRIGUARD_NGINX_IP=172.28.0.10

# --- Rate limits per visitor address (defaults: 10 sign-ins/registrations per 5 minutes,
#     30 scans per hour). A public demo that many people try at once may raise them. ---
# RATE_LIMIT_AUTH_PER_5MIN=10
# RATE_LIMIT_SCAN_PER_HOUR=30

# --- Public server only (docker-compose.prod.yml; docs/SETUP_AND_RUN.md section 9.8) ---
# These two make every `docker compose` command on the server use the production overlay
# and the Redis profile, so the commands in section 9 work there unchanged.
# COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml
# COMPOSE_PROFILES=redis
# The public name Caddy gets an HTTPS certificate for. Its DNS A record must point at the server.
# AGRIGUARD_DOMAIN=agriguard-demo.duckdns.org
# Fixed address of Caddy inside AGRIGUARD_SUBNET; NGINX trusts X-Forwarded-For only from it.
# AGRIGUARD_CADDY_IP=172.28.0.11
# Backend worker processes (each needs about 400 MB of memory).
# BACKEND_WORKERS=2

# --- Training profile (docker compose --profile training run --rm training) ---
AGRIGUARD_DEVICE=auto
AGRIGUARD_ARCHITECTURE=efficientnet_b0
AGRIGUARD_BATCH_SIZE=32
AGRIGUARD_NUM_EPOCHS=25
