# AgriGuard AI — LOCAL DEVELOPMENT configuration (native Windows/macOS/Linux, no Docker)
# Copy this file to `.env` at the repository root (scripts\install-backend.ps1 does this
# for you and fills in a random JWT_SECRET_KEY). backend/.env, if present, overrides it.
# Every variable below maps 1:1 to a field in backend/app/core/config.py::Settings.
# pydantic-settings reads UPPER_SNAKE_CASE env vars into lower_snake_case fields
# automatically (case-insensitive), matching the field names shown in parentheses.
#
# The optional Docker deployment uses docker/.env.example instead — keep production
# secrets out of this file.

# ============================== App ==============================
APP_NAME=AgriGuard AI                        # (app_name)
APP_ENV=development                          # (app_env) development | staging | production
API_PREFIX=/api/v1                           # (api_prefix)
DEBUG=true                                   # (debug)

# ============================== Database (PostgreSQL) ==============================
# (database_url) SQLAlchemy connection URL to your locally installed PostgreSQL.
# Create the role and database once (see README.md "Database setup").
DATABASE_URL=postgresql+psycopg2://agriguard:agriguard@127.0.0.1:5432/agriguard
DB_POOL_SIZE=10                              # (db_pool_size)
DB_MAX_OVERFLOW=20                           # (db_max_overflow)
DB_ECHO=false                                # (db_echo) log every SQL statement — dev only

# ============================== Redis (optional, not used) ==============================
# Nothing connects to Redis today: the weather cache and the rate limiter are in-process.
# Leave empty. (redis_url)
REDIS_URL=
WEATHER_CACHE_TTL_SECONDS=10800              # (weather_cache_ttl_seconds) 3 hours, BR7

# ============================== JWT / Auth ==============================
# (jwt_secret_key) Use a long random value — generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# It also signs the private image links. With APP_ENV=production the API refuses to
# start while this is the example value or shorter than 32 characters.
JWT_SECRET_KEY=CHANGE_ME_IN_PRODUCTION_ENV
JWT_ALGORITHM=HS256                          # (jwt_algorithm)
ACCESS_TOKEN_EXPIRE_MINUTES=15               # (access_token_expire_minutes)
REFRESH_TOKEN_EXPIRE_DAYS=30                 # (refresh_token_expire_days)
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30       # (password_reset_token_expire_minutes)

# ============================== Rate Limiting (NFR-SEC-5) ==============================
# Enforced by the backend itself (RateLimitMiddleware) — no NGINX needed locally.
RATE_LIMIT_AUTH_PER_5MIN=10                  # (rate_limit_auth_per_5min)
RATE_LIMIT_SCAN_PER_HOUR=30                  # (rate_limit_scan_per_hour)
RATE_LIMIT_DEFAULT_PER_5MIN=300              # (rate_limit_default_per_5min)
RATE_LIMIT_PREDICTION_PER_HOUR=60            # (rate_limit_prediction_per_hour) POST /outbreak/predictions

# ============================== Private media ==============================
# Scan photos, heatmaps and segmentation images are served only through signed, expiring
# URLs (/api/v1/media/...). They are issued inside responses that passed the owner/admin check.
MEDIA_URL_TTL_SECONDS=3600                   # (media_url_ttl_seconds) lifetime of an image link
LEGACY_PUBLIC_MEDIA=false                    # (legacy_public_media) true re-opens the old public /storage/scans and /storage/heatmaps paths

# ============================== Reports (docs/features/reports.md) ==============================
REPORT_SHARE_MAX_DAYS=30                     # (report_share_max_days) longest allowed share-link lifetime
REPORTS_LLM_ENABLED=true                     # (reports_llm_enabled) let Gemini word report summaries (needs GEMINI_API_KEY; validated, template fallback)

# ============================== File Upload (FR-SCAN-1) ==============================
MAX_UPLOAD_SIZE_BYTES=15728640               # (max_upload_size_bytes) 15MB
# (allowed_image_content_types) JSON array, pydantic-settings parses it automatically:
ALLOWED_IMAGE_CONTENT_TYPES=["image/jpeg","image/png","image/webp"]

# ============================== Storage & paths ==============================
# Leave these commented out to use the defaults, which are relative to the repository
# root (works from any working directory). Do not set them to an empty value.
#   LOCAL_STORAGE_DIR    default <repo>/storage    uploaded scans, heatmaps, PDF reports
#   LOG_DIR              default <repo>/logs
#   AI_ARTIFACTS_DIR     default <repo>/artifacts  (informational; see AGRIGUARD_ARTIFACTS_DIR)
STORAGE_BACKEND=local                        # (storage_backend) local | s3
S3_BUCKET=                                   # (s3_bucket) required only if STORAGE_BACKEND=s3
S3_ENDPOINT_URL=                             # (s3_endpoint_url)
S3_ACCESS_KEY=                               # (s3_access_key)
S3_SECRET_KEY=                               # (s3_secret_key)

# ============================== AI Pipeline ==============================
AI_ARTIFACTS_RUN_DIR=                        # (ai_artifacts_run_dir) empty = auto-use latest `python train.py` run

# ============================== Weather Integration (FR-WEATHER) ==============================
WEATHER_API_PROVIDER=open-meteo              # (weather_api_provider) Open-Meteo requires NO API key
WEATHER_API_KEY=                             # (weather_api_key) only needed for alternative providers
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1/forecast   # (weather_api_base_url)
WEATHER_REQUEST_TIMEOUT_SECONDS=5.0          # (weather_request_timeout_seconds)
WEATHER_ARCHIVE_BASE_URL=https://archive-api.open-meteo.com/v1/archive   # (weather_archive_base_url) daily history older than 92 days
WEATHER_FORECAST_CACHE_HOURS=3.0             # (weather_forecast_cache_hours) cached forecast days are re-fetched after this

# ============================== Outbreak Risk (docs/features/outbreak-prediction.md) ==============================
OUTBREAK_GRID_RESOLUTION_DEG=0.25            # (outbreak_grid_resolution_deg) >= 0.1; locations are aggregated to cells this size
OUTBREAK_MIN_CONTRIBUTORS=3                  # (outbreak_min_contributors) app-scan counts hidden below this many distinct users
OUTBREAK_HISTORY_DAYS=400                    # (outbreak_history_days) history window for features and trends
OUTBREAK_MIN_LOCAL_INSPECTIONS=5             # (outbreak_min_local_inspections) below this in a cell + neighbours: "insufficient data", never a risk level

# ============================== Gemini AI Reasoning Layer (optional) ==============================
# Adds a multimodal explanation layer on top of the existing Computer Vision
# diagnosis (see docs/GEMINI_INTEGRATION.md). The CV model remains the sole
# authority for disease detection; Gemini only explains/corroborates its result.
# Leave GEMINI_API_KEY empty to disable this feature entirely — every other part
# of the app (including scanning/diagnosis itself) works identically either way.
GEMINI_API_KEY=                              # (gemini_api_key) get one at https://aistudio.google.com/apikey — NEVER commit a real key here
GEMINI_MODEL=gemini-3.6-flash                # (gemini_model)
GEMINI_TIMEOUT_SECONDS=20.0                  # (gemini_timeout_seconds) per Gemini API call
GEMINI_MAX_TOOL_CALLS=6                      # (gemini_max_tool_calls) cap on function-calling round-trips per analysis

# ============================== Email / SMTP (FR-AUTH-4) ==============================
SMTP_HOST=                                   # (smtp_host) leave empty to disable password-reset emails in dev
SMTP_PORT=587                                # (smtp_port)
SMTP_USERNAME=                               # (smtp_username)
SMTP_PASSWORD=                               # (smtp_password)
SMTP_FROM_ADDRESS=no-reply@agriguard.ai      # (smtp_from_address)
SMTP_USE_TLS=true                            # (smtp_use_tls)

# ============================== CORS ==============================
# (cors_allow_origins) JSON array. The Vite dev server proxies /api to the backend, so
# the browser sees one origin and CORS is not needed for `npm run dev`; these cover
# calling the API directly from a dev page. Restrict this in production — "*" is dev-only.
CORS_ALLOW_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ============================== Logging (NFR-OBS-1) ==============================
LOG_LEVEL=INFO                               # (log_level)
LOG_JSON=true                                # (log_json)

# ============================== AI Training Pipeline (ai/config.py — separate from backend Settings) ==============================
# These are read directly by ai/config.py, NOT by backend/app/core/config.py. The
# backend's model loader also uses AGRIGUARD_ARTIFACTS_DIR to find the latest trained
# run, so training and the API must agree on it. Defaults are relative to the repo root.
# AGRIGUARD_DATASETS_DIR=./datasets
# AGRIGUARD_ARTIFACTS_DIR=./artifacts
AGRIGUARD_ARCHITECTURE=efficientnet_b0       # efficientnet_b0 | efficientnet_b3 | convnext_tiny | vit_base | mobilenetv4
AGRIGUARD_BATCH_SIZE=32
AGRIGUARD_NUM_EPOCHS=25
AGRIGUARD_LR=0.0003
AGRIGUARD_DEVICE=auto                        # auto | cpu | cuda | mps
