# AgriGuard AI — Environment Configuration
# Copy this file to `.env` at the repository root (or backend/.env) and adjust values.
# Every variable below maps 1:1 to a field in backend/app/core/config.py::Settings.
# pydantic-settings reads UPPER_SNAKE_CASE env vars into lower_snake_case fields
# automatically (case-insensitive), matching the field names shown in parentheses.

# ============================== App ==============================
APP_NAME=AgriGuard AI                        # (app_name)
APP_ENV=development                          # (app_env) development | staging | production
API_PREFIX=/api/v1                           # (api_prefix)
DEBUG=true                                   # (debug)

# ============================== Database ==============================
# (database_url) SQLAlchemy connection URL.
# Local dev / Docker Compose default (matches docker-compose.yml's postgres service):
DATABASE_URL=postgresql+psycopg2://agriguard:agriguard@postgres:5432/agriguard
DB_POOL_SIZE=10                              # (db_pool_size)
DB_MAX_OVERFLOW=20                           # (db_max_overflow)
DB_ECHO=false                                # (db_echo) log every SQL statement — dev only

# ============================== Redis ==============================
REDIS_URL=redis://redis:6379/0               # (redis_url)
WEATHER_CACHE_TTL_SECONDS=10800              # (weather_cache_ttl_seconds) 3 hours, BR7

# ============================== JWT / Auth ==============================
# (jwt_secret_key) CHANGE THIS in production — generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE_ME_IN_PRODUCTION_ENV
JWT_ALGORITHM=HS256                          # (jwt_algorithm)
ACCESS_TOKEN_EXPIRE_MINUTES=15               # (access_token_expire_minutes)
REFRESH_TOKEN_EXPIRE_DAYS=30                 # (refresh_token_expire_days)
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30       # (password_reset_token_expire_minutes)

# ============================== Rate Limiting (NFR-SEC-5) ==============================
RATE_LIMIT_AUTH_PER_5MIN=10                  # (rate_limit_auth_per_5min)
RATE_LIMIT_SCAN_PER_HOUR=30                  # (rate_limit_scan_per_hour)
RATE_LIMIT_DEFAULT_PER_5MIN=300              # (rate_limit_default_per_5min)

# ============================== File Upload (FR-SCAN-1) ==============================
MAX_UPLOAD_SIZE_BYTES=15728640               # (max_upload_size_bytes) 15MB
# (allowed_image_content_types) JSON array, pydantic-settings parses it automatically:
ALLOWED_IMAGE_CONTENT_TYPES=["image/jpeg","image/png","image/webp"]

# ============================== Storage ==============================
STORAGE_BACKEND=local                        # (storage_backend) local | s3
LOCAL_STORAGE_DIR=/app/storage               # (local_storage_dir) bind-mounted Docker volume
S3_BUCKET=                                   # (s3_bucket) required only if STORAGE_BACKEND=s3
S3_ENDPOINT_URL=                             # (s3_endpoint_url)
S3_ACCESS_KEY=                               # (s3_access_key)
S3_SECRET_KEY=                               # (s3_secret_key)

# ============================== AI Pipeline ==============================
AI_ARTIFACTS_DIR=/app/artifacts              # (ai_artifacts_dir) must match ai/config.py's artifacts_dir
AI_ARTIFACTS_RUN_DIR=                        # (ai_artifacts_run_dir) empty = auto-use latest `python train.py` run

# ============================== Weather Integration (FR-WEATHER) ==============================
WEATHER_API_PROVIDER=open-meteo              # (weather_api_provider) Open-Meteo requires NO API key
WEATHER_API_KEY=                             # (weather_api_key) only needed for alternative providers
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1/forecast   # (weather_api_base_url)
WEATHER_REQUEST_TIMEOUT_SECONDS=5.0          # (weather_request_timeout_seconds)

# ============================== Gemini AI Reasoning Layer (optional) ==============================
# Adds a multimodal explanation layer on top of the existing Computer Vision
# diagnosis (see docs/GEMINI_INTEGRATION.md). The CV model remains the sole
# authority for disease detection; Gemini only explains/corroborates its result.
# Leave GEMINI_API_KEY empty to disable this feature entirely — every other part
# of the app (including scanning/diagnosis itself) works identically either way.
GEMINI_API_KEY=                              # (gemini_api_key) get one at https://aistudio.google.com/apikey — NEVER commit a real key here
GEMINI_MODEL=gemini-2.5-flash                # (gemini_model)
GEMINI_TIMEOUT_SECONDS=20.0                  # (gemini_timeout_seconds) per Gemini API call
GEMINI_MAX_TOOL_CALLS=6                      # (gemini_max_tool_calls) cap on function-calling round-trips per analysis

# ============================== Email / SMTP (FR-AUTH-4) ==============================
SMTP_HOST=                                   # (smtp_host) leave empty to disable password-reset emails in dev
SMTP_PORT=587                                # (smtp_port)
SMTP_USERNAME=                               # (smtp_username)
SMTP_PASSWORD=                               # (smtp_password)
SMTP_FROM_ADDRESS=no-reply@agriguard.ai      # (smtp_from_address)
SMTP_USE_TLS=true                            # (smtp_use_tls)

# ============================== CORS ==============================
# (cors_allow_origins) JSON array. Restrict this in production — "*" is dev-only.
CORS_ALLOW_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ============================== Logging (NFR-OBS-1) ==============================
LOG_LEVEL=INFO                               # (log_level)
LOG_JSON=true                                # (log_json)
LOG_DIR=./logs                               # (log_dir)

# ============================== AI Training Pipeline (ai/config.py — separate from backend Settings) ==============================
# These are read directly by ai/config.py, NOT by backend/app/core/config.py, but are
# documented here since they govern the same overall system (C1: no hardcoded paths).
AGRIGUARD_DATASETS_DIR=./datasets
AGRIGUARD_ARTIFACTS_DIR=./artifacts
AGRIGUARD_ARCHITECTURE=efficientnet_b0       # efficientnet_b0 | efficientnet_b3 | convnext_tiny | vit_base | mobilenetv4
AGRIGUARD_BATCH_SIZE=32
AGRIGUARD_NUM_EPOCHS=25
AGRIGUARD_LR=0.0003
AGRIGUARD_DEVICE=auto                        # auto | cpu | cuda | mps
