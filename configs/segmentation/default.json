{
  "_comment": "Disease-localization training config. Every key is optional; see ai/segmentation/config.py for meanings. CLI flags (--epochs, --batch-size, --device) override these.",
  "architecture": "unet",
  "encoder": "efficientnet_b0",
  "encoder_pretrained": true,
  "image_size": 384,
  "max_side": 1024,
  "split_ratios": [0.7, 0.15, 0.15],
  "seed": 42,
  "augment": {"hflip": true, "vflip": true, "rotate90": true, "scale": [0.5, 1.0], "color_jitter": 0.2},
  "batch_size": 8,
  "epochs": 60,
  "optimizer": "adamw",
  "learning_rate": 0.0003,
  "weight_decay": 0.0001,
  "scheduler": "cosine",
  "loss": "ce_dice",
  "class_weights": "auto",
  "early_stopping_patience": 10,
  "mixed_precision": true,
  "device": "auto",
  "num_workers": 2,
  "min_train_images": 20,
  "min_leaf_pixels": 500
}
