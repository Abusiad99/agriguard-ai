datasets/plantwild_v2/**/*.jpg filter=lfs diff=lfs merge=lfs -text
datasets/plantwild_v2/**/*.jpeg filter=lfs diff=lfs merge=lfs -text
datasets/plantwild_v2/**/*.png filter=lfs diff=lfs merge=lfs -text

# Scripts that run inside Linux containers must keep LF line endings on every OS
# (Git for Windows' core.autocrlf would otherwise check them out with CRLF).
*.sh text eol=lf
