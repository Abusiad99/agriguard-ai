%%{init: {'theme': 'neutral'}}%%
flowchart TB
    In(["Validated Image\n(from Process 2.0 parent)"])

    P21(["2.1 Identify Plant Species\n(FR-AI-1)"])
    P22(["2.2 Classify Disease\n(FR-AI-2)"])
    P23(["2.3 Detect Pests\n(FR-AI-3)"])
    P24(["2.4 Localize Affected Region\n(FR-AI-4)"])
    P25(["2.5 Estimate Severity\n(FR-AI-5)"])
    P26(["2.6 Compute Confidence Score\n(FR-AI-6)"])
    P27(["2.7 Generate Explainability\nHeatmap (FR-AI-7)"])

    D3[("D3: Knowledge Base\n(species/disease taxonomy)")]
    D2[("D2: Diagnoses")]

    Out(["Raw Diagnosis Object\n→ to Process 3.0"])
    LowConf(["'Unrecognized Plant' result\n→ to Farmer (Alt Flow A1)"])

    In --> P21
    P21 -- "species + confidence" --> Gate{"confidence ≥\nthreshold?\n(FR-AI-12)"}
    Gate -- "no" --> LowConf
    Gate -- "yes" --> P22
    P21 -. "validate against known taxonomy" .-> D3

    P22 -- "disease label + confidence" --> P24
    P22 -. "validate against known taxonomy" .-> D3
    In --> P23
    P23 -- "pest evidence" --> Out

    P24 -- "bounding box / mask" --> P25
    P25 -- "% affected area" --> P26
    P26 -- "final confidence score" --> P27
    P27 -- "heatmap overlay image" --> Out

    P22 --> Out
    P25 --> Out
    Out --> D2
